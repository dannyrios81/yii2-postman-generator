{
    "name": "iguazoft/yii2-postman-generator",
    "description": "Yii2 extension to generate Postman collections from PHPDoc annotations",
    "type": "yii2-extension",
    "keywords": [
        "yii2",
        "postman",
        "api",
        "documentation",
        "phpdoc"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Iguazoft",
            "email": "soporte@iguazoft.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "yiisoft/yii2": "~2.0.0"
    },
    "autoload": {
        "psr-4": {
            "iguazoft\\postman\\": "src/"
        }
    },
    "extra": {
        "bootstrap": "iguazoft\\postman\\Bootstrap"
    }
}